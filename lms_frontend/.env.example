# Supabase configuration (preferred for Vite-style builds)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional site URL used for auth redirects (if omitted, falls back to window.location.origin)
# VITE_SITE_URL=http://localhost:3000

# CRA fallback variables (optional). If VITE_* are not set, the client will try these:
# Note: Do not commit real secrets. Only use anon/public key on the client.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# Some environments previously used these as generic API bases; they are considered final fallbacks for URL:
# REACT_APP_API_BASE=
# REACT_APP_BACKEND_URL=

# Reminder: after changing env variables, restart your dev server or preview for changes to take effect.
