# LMS Frontend (Create React App) - Environment Variables

# Supabase (Client-side, anon/public key only)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_KEY=YOUR_ANON_PUBLIC_KEY

# Frontend site URL used for auth redirects (optional; falls back to window.location.origin)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Existing variables (retain your current values if already set)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
