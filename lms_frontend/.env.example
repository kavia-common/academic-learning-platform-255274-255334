# Create React App environment variables for Supabase (client-side only)
# Copy this file to .env and replace placeholder values.

# REQUIRED
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-ANON-KEY

# OPTIONAL (used by getURL() for auth redirects; defaults to window.location.origin)
REACT_APP_FRONTEND_URL=http://localhost:3000
